{
  "name": "react-native-queue-player",
  "version": "3.0.14",
  "description": "Nitro Modules audio playback library for React Native — gapless, EQ, crossfade, automotive, voice, casting",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "nitrogen",
    "nitro.json",
    "*.podspec",
    "app.plugin.js",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "build": "bob build",
    "clean": "del-cli android/build lib nitrogen",
    "prepare": "bob build",
    "nitrogen": "nitrogen",
    "typecheck": "tsc",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "release:rc": "node scripts/release.mjs rc",
    "publish:npm": "npm publish --access public"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "audio",
    "music",
    "player",
    "queue",
    "nitro",
    "nitro-module",
    "gapless",
    "crossfade",
    "equalizer",
    "visualizer",
    "fft",
    "carplay",
    "android-auto",
    "airplay",
    "chromecast",
    "siri",
    "google-assistant"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pizzapanther/react-native-queue-player-plus.git"
  },
  "author": "Paul Bailey <paul@neutron.studio> (https://github.com/pizzapanther)",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/pizzapanther/react-native-queue-player-plus/issues"
  },
  "homepage": "https://pizzapanther.github.io/react-native-queue-player-plus/",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@expo/config-plugins": "^58.0.9",
    "@expo/plist": "^0.10.1",
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@types/react": "^19.3.0",
    "@types/react-test-renderer": "19.3.0",
    "del-cli": "^7.0.0",
    "jest": "^29.7.0",
    "nitrogen": "^0.37.1",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.41.0",
    "react-native-nitro-modules": "^0.37.1",
    "react-test-renderer": "19.3.0",
    "turbo": "^2.8.21",
    "typescript": "^6.0.2"
  },
  "peerDependencies": {
    "@expo/config-plugins": ">=58.0.0",
    "react": ">=19.3.0",
    "react-native": ">=0.88.0",
    "react-native-nitro-modules": "^0.37.1"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "custom",
        {
          "script": "nitrogen",
          "clean": "nitrogen/"
        }
      ],
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "transform": {
      "^.+\\.(js|ts|tsx)$": [
        "babel-jest",
        { "presets": ["module:@react-native/babel-preset"] }
      ]
    },
    "modulePathIgnorePatterns": [
      "<rootDir>/lib/",
      "<rootDir>/nitrogen/"
    ],
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.nitro.ts",
      "!src/**/__tests__/**"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "html",
      "lcov"
    ]
  },
  "create-react-native-library": {
    "type": "nitro-module",
    "languages": "kotlin-swift",
    "tools": [
      "jest"
    ],
    "version": "0.62.0"
  },
  "codegenConfig": {
    "name": "QueuePlayerSpec",
    "type": "modules",
    "jsSrcsDir": "./src",
    "android": {
      "javaPackageName": "com.margelo.nitro.queueplayer"
    }
  }
}
